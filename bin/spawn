#!/usr/bin/env -S scala-cli shebang
//> using scala 3.8.3
//> using jvm 17

import scala.sys.process.*
import java.nio.file.*

def appendLine(out: Path, s: String) =
  Files.writeString(out, s + "\n", StandardOpenOption.APPEND)

val servicesRoot = "TODO"
val out = Files.createTempFile(null, null)

def w(s: String) = appendLine(out, s)

w("tell application \"iTerm\"")
w("  create window with default profile")

shiftArgument(out, args.toList, false)

w("end tell")

val path = out.toString
println(s"cat $path".!!)
(s"cat $path" #| "osascript").!

def shiftArgument(out: Path, args: Seq[String], splitWindow: Boolean): Unit =
  def w(s: String) = appendLine(out, s)

  args match {
    case path :: tail =>
      if (splitWindow) {
        w("  tell current session of current window\n")
        w("    set newSession to split horizontally with default profile\n")
        w("  end tell\n")
      } else {
        w("    set newSession to current session of current window\n")
      }

      w("  tell newSession \n")
      w(s"""    write text \"cd $servicesRoot/$path\"\n""")
      w("  end tell\n")

      shiftArgument(out, tail, true)
    case Nil =>
  }
